generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserSetting {
  id          String   @id @default(cuid())
  startDate   DateTime @default(now())
  startWeight Float?
  targetWeight Float?
  theme       String   @default("dark")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DayLog {
  id               String   @id @default(cuid())
  date             DateTime @unique
  morningWeight    Float?
  eveningWeight    Float?
  dietDone         Boolean  @default(false)
  workoutDone      Boolean  @default(false)
  supplementsDone  Boolean  @default(false)
  cycleDone        Boolean  @default(false)
  bloodworkPlanned Boolean  @default(false)
  bloodworkDone    Boolean  @default(false)
  dietText         String?
  bloodworkNote    String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Plan {
  id               String    @id @default(cuid())
  type             String
  name             String
  abbreviation     String?
  startDate        DateTime
  endDate          DateTime?
  weekdays         String    @default("1,2,3,4,5,6,7")
  content          String?
  active           Boolean   @default(true)
  doctorSupervised Boolean   @default(false)
  repeatType       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dayTasks         DayTask[]
}

model DayTask {
  id        String   @id @default(cuid())
  date      DateTime
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  title     String
  type      String
  completed Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, date])
}

model WorkoutTemplate {
  id        String                    @id @default(cuid())
  name      String
  weekday   Int
  active    Boolean                   @default(true)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  exercises WorkoutExerciseTemplate[]
  sessions  WorkoutSession[]
}

model WorkoutExerciseTemplate {
  id                String          @id @default(cuid())
  workoutTemplateId String
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  name              String
  sets              Int             @default(3)
  targetReps        String?
  note              String?
  order             Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model WorkoutSession {
  id                String           @id @default(cuid())
  date              DateTime
  workoutTemplateId String?
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  title             String
  completed         Boolean          @default(false)
  startedAt         DateTime?
  finishedAt        DateTime?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  setLogs           WorkoutSetLog[]
}

model WorkoutSetLog {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseName     String
  setNumber        Int
  weight           Float?
  reps             Int?
  completed        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}
